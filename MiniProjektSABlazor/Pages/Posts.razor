@page "/posts"
@using MiniProjektSA.Models
@using MiniProjektSABlazor.Services
@inject NavigationManager Nav
@inject PostService PostService

<h3>Posts</h3>

@if (allPosts == null)
{
    <p>Indlæser :) ...</p>
}
else
{
    <div class="post-list">
        @foreach (var post in allPosts.Where(p => p.MotherPostId == null))
        {
            if (post.Votescore == null)
            {
                post.Votescore = 0;
            }

            <div class="post-card">
            
                <div class="vote-column">
                    <span class="vote-score">@post.Votescore</span>
                </div>

                <div class="post-content">
                    <h3 class="post-title">@post.Title</h3>

                    <p class="post-text">@post.Content</p>

                    <div class="post-meta">
                        @post.PublishDate.ToLocalTime()
                    </div>

                    <div class="post-actions">
                        <button class="btn-primary"
                                @onclick='() => Nav.NavigateTo($"/post/{post.Id}")'>
                            Åben opslag
                        </button>
                    </div>
                </div>

            </div>
        }
    </div>
}

@code {
    private List<PostModel> allPosts;

    protected override async Task OnInitializedAsync()
    {
        allPosts = await PostService.GetAll();
    }
}