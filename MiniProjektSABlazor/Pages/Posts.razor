@page "/posts"
@using MiniProjektSA.Models
@using MiniProjektSABlazor.Services
@inject PostService PostService

<h3>Posts</h3>

@if (allPosts == null)
{
    <p>Loading...</p>
}
else
{
    <div class="post-list">
        @foreach (var post in allPosts.Where(p => p.MotherPostId == null))
        {
            <div class="card-body">
                <h4 class="card-title">@post.Votescore</h4>
                <h5 class="card-title">@post.Title</h5>

                <p class="card-text">
                    <p>@post.Content</p>
                    <p>@post.PublishDate.ToLocalTime()</p>
                </p>
            </div>
        }
    </div>
}

@code {
    private List<PostModel> allPosts;

    protected override async Task OnInitializedAsync()
    {
        allPosts = await PostService.GetAll();
    }
}