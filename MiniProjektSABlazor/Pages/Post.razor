@page "/Post/{postid:int}"

@using MiniProjektSA.Models
@using Services

@inject NavigationManager Nav
@inject PostService PostService

@if (post == null)
{
    <p>Indlæser...</p>
}
else
{
    <!-- HOVEDOPSLAG -->
    <div class="post-card">
        <div class="vote-column">

            <button class="vote-btn up"
                    @onclick="() => VotePost(post.Id, true)">
                ▲
            </button>

            <span class="vote-score">@post.Votescore</span>

            <button class="vote-btn down"
                    @onclick="() => VotePost(post.Id, false)">
                ▼
            </button>

        </div>

        <div class="post-content">
            <h3 class="post-title">@post.Title</h3>
            <p class="post-text">@post.Content</p>
            <div class="post-meta">
                Publiseret: @post.PublishDate.ToLocalTime()
            </div>
        </div>
    </div>


    <!-- KOMMENTARER -->
    <div class="post-list">
        @foreach (var c in Comments)
        {
            <div class="post-card comment-card">
                <div class="vote-column">

                    <button class="vote-btn up"
                            @onclick="() => VoteComment(Postid, c.Id, true)">
                        ▲
                    </button>

                    <span class="vote-score">@c.Votescore</span>

                    <button class="vote-btn down"
                            @onclick="() => VoteComment(Postid, c.Id, true)">
                        ▼
                    </button>

                </div>
                <div class="post-content">
                    <h4 class="post-title">@c.Title</h4>
                    <p class="post-text">@c.Content</p>
                    <div class="post-meta">
                        @c.PublishDate.ToLocalTime()
                    </div>
                    <div class="post-actions">
                        <button class="btn-primary"
                                @onclick='() => Nav.NavigateTo($"/post/{c.Id}")'>
                            Åben kommentar
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>


    <!-- OPRET KOMMENTAR -->
    <div class="comment-form">

        <h3>Tilføj kommentar</h3>

        <input class="input-field"
               placeholder="Title"
               @bind="newComment.Title" />

        <textarea class="input-field"
                  placeholder="Content"
                  @bind="newComment.Content">
        </textarea>

        <button class="btn-primary"
                @onclick="CreateNewComment">
            Opret
        </button>

    </div>
}

@code {
    [Parameter]
    public int Postid { get; set; } 

    private PostModel? post;

    private List<PostModel> Comments = new();

    private PostModel newComment = new("", "", DateTime.Now, null, null);

    protected override async Task OnParametersSetAsync()
    {
        post = await PostService.Get(Postid);
        var allPosts = await PostService.GetAll();
        Comments = allPosts.Where(p => p.MotherPostId == Postid).ToList();
    }
    
    private async Task CreateNewComment()
    {
        Console.WriteLine("Creating new post");

        if (string.IsNullOrWhiteSpace(newComment.Title) ||
            string.IsNullOrWhiteSpace(newComment.Content))
        {
            return;
        }

        newComment.MotherPostId = Postid; // sikre at kommentaren tilhøre selve postet
        await PostService.CreateComment(Postid, newComment);
        await OnParametersSetAsync();
        newComment = new("", "", DateTime.Now, null, Postid);
    }

    private async Task VoteComment(int PostId, int CommentId, bool UpDown)
    {
        if (UpDown)
        {
            await PostService.UpvoteComment(Postid, CommentId);
            await OnParametersSetAsync();
        }
        else if (UpDown == false)
        {
            await PostService.DownvoteComment(PostId, CommentId);
            await OnParametersSetAsync();
        }
    }
    
    private async Task VotePost(int PostId, bool UpDown)
    {
        if (UpDown)
        {
            await PostService.Upvote(Postid);
            await OnParametersSetAsync();
        }
        else if (UpDown == false)
        {
            await PostService.Downvote(PostId);
            await OnParametersSetAsync();
        }
    }
}