@page "/Post/{postid:int}"

@using MiniProjektSA.Models
@using Services

@inject NavigationManager Nav
@inject PostService PostService

<h3>Post #@Postid</h3>

@if (post == null)
{
    <p>Indlæser...</p>
}
else
{
    <div>
        <h4>@post.Title</h4>
        <p>@post.Content</p>
        <p>Votes: @post.Votescore</p>
        <p>Publiseret: @post.PublishDate.ToLocalTime()</p>
    </div>
    
    <div class="post-list">
        @foreach (var c in Comments)
        {
            <div class="card-body">
                <h4 class="card-title">@post.Votescore</h4>
                <h5 class="card-title">@post.Title</h5>
                
                <p>@post.Content</p>
                <p>@post.PublishDate.ToLocalTime()</p>
                    
                <button @onclick='() => Nav.NavigateTo($"/post/{c.Id}")'>Åben comment</button>
                
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public int Postid { get; set; } 

    private PostModel? post;

    private List<PostModel> Comments = new();

    protected override async Task OnParametersSetAsync()
    {
        post = await PostService.Get(Postid);
        var allPosts = await PostService.GetAll();
        Comments = allPosts.Where(p => p.MotherPostId == Postid).ToList();
    }
}